<%- include("partials/header.ejs") %>

    <section class="login-form-container" style="padding: 4rem 2rem; text-align: center;">
        <h1 style="margin-bottom: 2rem;">Admin Login</h1>
        <form action="/login" method="POST" style="max-width: 400px; margin: 0 auto;">
            <div style="margin-bottom: 1.5rem;">
                <input type="text" name="username" placeholder="Username" required
                    style="width: 100%; padding: 1rem; border-radius: 10px; border: 1px solid #4a5568; background: #2d3748; color: #e2e8f0; font-size: 1rem;">
            </div>
            <div style="margin-bottom: 1.5rem;">
                <input type="password" name="password" placeholder="Password" required
                    style="width: 100%; padding: 1rem; border-radius: 10px; border: 1px solid #4a5568; background: #2d3748; color: #e2e8f0; font-size: 1rem;">
            </div>
            <button type="submit" class="cta-button">Login</button>
        </form>
    </section>

<%- include('partials/footer.ejs') %>